#!/usr/bin/env bash

if [ "$1" = "self-update" ]; then
    if [ "$#" -ne 1 ]; then
        echo "Usage: $0 self-update" >&2
        exit 1
    fi
    if ! command -v git &>/dev/null; then
        echo "Error: self-update requires Git." >&2
        exit 1
    fi
    script_path="${BASH_SOURCE[0]}"
    while [ -L "$script_path" ]; do
        script_dir="$(cd -P "$(dirname "$script_path")" && pwd)" || exit $?
        script_path="$(readlink "$script_path")" || exit $?
        [[ "$script_path" = /* ]] || script_path="$script_dir/$script_path"
    done
    script_dir="$(cd -P "$(dirname "$script_path")" && pwd)" || exit $?
    repo="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)" || repo=""
    if [ -z "$repo" ] || [ ! "$repo/bin/docker-compose-plus" -ef "$script_path" ] ||
       ! git -C "$repo" ls-files --error-unmatch bin/docker-compose-plus &>/dev/null; then
        echo "Error: self-update is only available when installed from a Git clone of docker-compose-plus. This appears to be a standalone or nonstandard installation." >&2
        exit 1
    fi
    git -C "$repo" pull --ff-only
    exit $?
fi

env="$1"
shift
if [ "$env" != "dev" ] && [ "$env" != "staging" ] && [ "$env" != "prod" ]; then
    if [ -n "$env" ]; then
        echo "Error: Invalid env '$env'"
    fi
    echo "Usage: $0 dev|staging|prod"
    exit 1
fi
if [ -f docker-compose.yml ]; then
    extra_args="--env-file .env.$env -f docker-compose.yml -f docker-compose.$env.yml"
    file=".env.$env"
elif [ -f ".env.$env.jsonnet" ]; then
    extra_args="-f -"
    file=".env.$env.jsonnet"
else
    file="docker-compose.yml/docker-compose.libsonnet"
fi
[ -f "$file" ] || {
    echo "Error: $file does not exist. Make sure you are in the right folder."
    exit 1
}

project_name="$(basename "$PWD" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -cd 'a-z0-9_-' | sed 's/^[-_]*//')"
if [ -z "$project_name" ]; then
    echo "Error: Folder name contains no valid Compose project name characters." >&2
    exit 1
fi

if [ "$env" = "prod" ] && [ "$1" = "deploy" ]; then
    shift
    rendered="$(jsonnet "$file" --ext-code useSwarm=true)" || exit $?
    if [ "$#" -gt 0 ]; then
        service_args=()
        service_index=0
        for service in "$@"; do
            service_args+=(--ext-str "service$service_index=$service")
            service_index=$((service_index + 1))
        done
        rendered="$(jsonnet --ext-code-file config=/dev/stdin \
            --ext-code "serviceCount=$#" "${service_args[@]}" -e '
            local config = std.extVar("config");
            local selected = std.set([
                std.extVar("service" + std.toString(i))
                for i in std.range(0, std.extVar("serviceCount") - 1)
            ]);
            local unknown = [s for s in selected if !std.objectHas(config.services, s)];
            local services = {
                [s]: {
                    [field]: config.services[s][field]
                    for field in std.objectFields(config.services[s])
                    if field != "depends_on"
                }
                for s in selected
            };
            local references(service, kind) =
                local entries = if std.objectHas(service, kind) then service[kind] else [];
                if kind == "networks" then
                    if std.length(entries) == 0 && !std.objectHas(service, "network_mode") then ["default"]
                    else if std.type(entries) == "object" then std.objectFields(entries)
                    else entries
                else [
                    if std.type(entry) == "string" then
                        if kind == "volumes" then std.split(entry, ":")[0] else entry
                    else if std.objectHas(entry, "source") then entry.source else ""
                    for entry in entries
                    if kind != "volumes" ||
                       (std.type(entry) == "string" && std.length(std.split(entry, ":")) > 1) ||
                       (std.type(entry) == "object" && std.objectHas(entry, "type") && entry.type == "volume")
                ];
            local resources = ["networks", "volumes", "secrets", "configs"];
            assert std.length(unknown) == 0 : "Unknown service(s): " + std.join(", ", unknown);
            {
                [field]: config[field]
                for field in std.objectFields(config)
                if field != "services" && !std.member(resources, field)
            } + { services: services } + {
                [kind]: {
                    [name]: config[kind][name]
                    for name in std.objectFields(config[kind])
                    if std.member(
                        std.flattenArrays([references(services[s], kind) for s in std.objectFields(services)]),
                        name
                    )
                }
                for kind in resources
                if std.objectHas(config, kind)
            }
        ' <<< "$rendered")" || exit $?
    fi
    docker stack deploy --compose-file - "$project_name" <<< "$rendered"
    exit $?
fi

run_docker_compose() {
    if command -v docker-compose &>/dev/null; then
        docker-compose "$@"
    else
        docker compose "$@"
    fi
}

{
    if [ -f ".env.$env.jsonnet" ]; then
        jsonnet "$file" --ext-code useSwarm=false
    fi
} | COMPOSE_DOCKER_CLI_BUILD=1 DOCKER_BUILDKIT=1 run_docker_compose $(echo $extra_args) -p "$project_name-$env" "$@"

